{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "cd frontend && npm ci",
  "buildCommand": "cd frontend && npm run build",
  "outputDirectory": "frontend/dist",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/:path(results|config|version|health|ingestion|observations|harmonize|live-analysis|audit|docs|openapi.json)",
      "destination": "https://YOUR-USER-arkagni.hf.space/:path"
    },
    {
      "source": "/:path(results|config|version|health|ingestion|observations|harmonize|live-analysis|audit|docs)/:rest*",
      "destination": "https://YOUR-USER-arkagni.hf.space/:path/:rest*"
    },
    {
      "source": "/((?!assets/|api/).*)",
      "destination": "/index.html"
    }
  ]
}
